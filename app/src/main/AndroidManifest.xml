<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuestApp">

        <!-- 1. Pantalla de Inicio (Login) - LAUNCHER -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Pantallas de Flujo de Usuario -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".DetallePartidaActivity"
            android:exported="false" />

        <!-- 3. Apartado de Recursos y sus derivados -->
        <activity
            android:name=".RecursosActivity"
            android:exported="false" />
        <activity
            android:name=".PersonajesActivity"
            android:exported="false" />
        <activity
            android:name=".ReglasActivity"
            android:exported="false" />

        <!-- 4. Apartado de Dados -->
        <activity
            android:name=".DadosActivity"
            android:exported="false"
            android:label="Lanzador de Dados" />

        <!-- 5. Apartado de Hechizos y Armas (Equipo) -->
        <activity
            android:name=".EquipoActivity"
            android:exported="false"
            android:label="Hechizos y Armas" />

    </application>

</manifest>