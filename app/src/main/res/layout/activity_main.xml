<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="#F5F5F5">

    <ImageView
        android:id="@+id/iv_user_photo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="20dp"
        android:src="@android:drawable/ic_menu_camera"
        android:background="@drawable/shape_circle"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tv_user_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="usuario@email.com"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        android:textColor="#666666"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mis Partidas Activas"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_gravity="start"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_partidas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        tools:listitem="@layout/item_partida" />

    <Button
        android:id="@+id/btn_crear_partida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="➕ Crear Nueva Partida"
        android:backgroundTint="#2E7D32"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btn_ir_recursos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📚 Recursos y Reglas"
        android:layout_marginTop="10dp"
        android:backgroundTint="#546E7A"/>

    <Button
        android:id="@+id/btn_logout"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cerrar Sesión"
        android:textColor="#FF5252"
        android:layout_marginTop="10dp" />

</LinearLayout>