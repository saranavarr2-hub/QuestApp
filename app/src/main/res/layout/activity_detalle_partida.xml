<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp"
        android:paddingBottom="12dp"
        android:paddingTop="60dp">

        <EditText
            android:id="@+id/et_nombre_detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la Partida"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:layout_marginBottom="5dp"
            android:inputType="textCapSentences"/>

        <EditText
            android:id="@+id/et_master_detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Master: Usuario"
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:layout_marginBottom="25dp"
            android:inputType="textPersonName"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado del grupo (HP/Recursos)"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/et_puntos_vida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 45/50 HP"
            android:inputType="text"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lista de Jugadores y Personajes"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/et_jugadores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Juan - Guerrero\nAna - Hechicera..."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notas de la aventura"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/et_notas_partida"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="20dp"
            android:background="@android:drawable/editbox_background"
            android:gravity="top"
            android:hint="Escribe aquí lo ocurrido en la sesión..."
            android:inputType="textMultiLine"
            android:padding="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enlace del Mapa (URL de imagen)"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/et_url_mapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://ejemplo.com/mapa.jpg"
            android:inputType="textUri"
            android:layout_marginBottom="10dp"/>


        <ImageView
            android:id="@+id/iv_mapa_detalle"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerInside"
            android:background="#EEEEEE"
            android:src="@android:drawable/ic_menu_gallery"
            android:padding="20dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="Vista previa del mapa" />

        <Button
            android:id="@+id/btn_guardar_detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Guardar Cambios"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>
</ScrollView>